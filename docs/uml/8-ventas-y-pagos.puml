@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam dpi 150
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam packageStyle rectangle
hide empty members
title Ventas y pagos
class Venta {
  - id : Long
  - numero : String
  - fechaHora : LocalDateTime
  - cliente : String
  - vendedor : String
  + getTotal() : BigDecimal
  + getCosto() : BigDecimal
  + getOpGravada() : BigDecimal
  + getIgv() : BigDecimal
}
class LineaVenta {
  - producto : String
  - precioUnitario : BigDecimal
  - costoUnitario : BigDecimal
  - cantidad : int
  + getSubtotal() : BigDecimal
  + getCostoTotal() : BigDecimal
}
class Producto {
  - codigo : String
  - nombre : String
  - descripcion : String
  - costoDolares : BigDecimal
  - precio : BigDecimal
  - proveedor : String
  - fechaIngreso : LocalDate
  - stock : int
  - stockMinimo : int
  + descontarStock(cantidad) : void
  + reponerStock(cantidad) : void
  + estaBajoMinimo() : boolean
  + getCostoSoles() : BigDecimal
}
enum CategoriaProducto {
  HERRAMIENTAS
  CONSTRUCCION
  ELECTRICIDAD
  GASFITERIA
  PINTURAS
}
abstract class Pago {
  + {abstract} validar(total : BigDecimal) : void
  + {abstract} descripcion(total : BigDecimal) : String
}
class PagoEfectivo {
  - recibido : BigDecimal
  + vuelto(total) : BigDecimal
}
class PagoTarjeta {
  - ultimosCuatro : String
}
class PagoYape {
  - celular : String
}
class PagoTransferencia {
  - numeroOperacion : String
}
enum Sede {
  LIMA
  AREQUIPA
  TRUJILLO
}
class VentaService {
  + registrar(items, pago, sede, cliente, vendedor) : Venta
  + listar() : List<Venta>
  + buscar(id) : Venta
}
Venta *--> "1..*" LineaVenta
Venta --> "1" Pago
LineaVenta --> CategoriaProducto
Producto --> CategoriaProducto
Pago <|-- PagoEfectivo
Pago <|-- PagoTarjeta
Pago <|-- PagoYape
Pago <|-- PagoTransferencia
Venta --> Sede
VentaService ..> Venta : crea
VentaService ..> Producto : descuenta stock
@enduml

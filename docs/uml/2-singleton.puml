@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam dpi 150
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam packageStyle rectangle
hide empty members
title Patrón Singleton
class ConfiguracionGlobal {
  - {static} instancia : ConfiguracionGlobal
  - razonSocial : String
  - ruc : String
  - direccion : String
  - telefono : String
  - igv : BigDecimal
  - tipoCambio : BigDecimal
  - ConfiguracionGlobal()
  + {static} getInstancia() : ConfiguracionGlobal
  + actualizar(razonSocial, ruc, direccion, telefono, igv, tipoCambio) : void
  + convertirASoles(dolares : BigDecimal) : BigDecimal
  + getRazonSocial() : String
  + getIgv() : BigDecimal
  + getTipoCambio() : BigDecimal
}
ConfiguracionGlobal --> ConfiguracionGlobal : instancia
class Venta
class Producto
class SelloFerreteriaDecorador
class ConfiguracionController
Venta ..> ConfiguracionGlobal : IGV
Producto ..> ConfiguracionGlobal : tipo de cambio
SelloFerreteriaDecorador ..> ConfiguracionGlobal : getInstancia()
ConfiguracionController ..> ConfiguracionGlobal : getInstancia()
@enduml
